# Salin file ini menjadi ".env" di server produksi lalu isi nilainya.
# JANGAN commit file ".env" (yang sudah diisi) ke Git/dibagikan.

# String acak yang aman, minimal 32 karakter. Generate contoh:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# Koneksi database produksi (JANGAN pakai root tanpa password).
# Format: mysql+pymysql://<user>:<password>@<host>/<nama_database>
DATABASE_URL=mysql+pymysql://eka_app:password_yang_kuat@127.0.0.1/nursing_career

# Set ke 1 kalau situs sudah diakses lewat HTTPS (mengunci cookie sesi
# supaya hanya dikirim lewat koneksi terenkripsi).
FORCE_HTTPS=0

# Set ke 0 kalau Gunicorn dijalankan dengan LEBIH DARI 1 worker, supaya
# job harian pengecekan SIP/SPK-RKK kedaluwarsa tidak terpanggil dobel
# per worker. Kalau di-set 0, WAJIB jadwalkan `flask cek-kedaluwarsa`
# lewat cron (lihat deploy/README_DEPLOY.md).
ENABLE_SCHEDULER=1
